<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#14FFFFFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#05EAFBFF" />
            <stroke
                android:width="1dp"
                android:color="#34FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="45"
                android:startColor="#00FFFFFF"
                android:centerColor="#08D7F7FF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
