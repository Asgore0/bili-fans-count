<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="10dp"
    android:paddingEnd="15dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/widget_name"
            android:textColor="@color/widget_primary_text"
            android:shadowColor="#66001421"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_refresh_content_description"
            android:padding="6dp"
            android:scaleType="center"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_chip_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_followers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_placeholder"
        android:textColor="@color/widget_follower_text"
        android:shadowColor="#A3001422"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textSize="47sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_status_realtime"
            android:textColor="@color/widget_chip_text"
            android:shadowColor="#82001422"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/widget_waiting"
            android:textColor="@color/widget_secondary_text"
            android:shadowColor="#73001422"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
